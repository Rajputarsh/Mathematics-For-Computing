import sympy as sp

A = sp.Matrix([[1, 0],
               [0, 2]])

print("Eigenvalues:")
print(A.eigenvals())

print("Eigenvectors:")
print(A.eigenvects())

# Diagonalization
P, D = A.diagonalize()

print("Matrix P:")
print(P)

print("Diagonal Matrix D:")
print(D)

# Cayley-Hamilton theorem
x = sp.symbols('x')
p = A.charpoly(x).as_expr()

print("Characteristic Polynomial:")
print(p)

print("Cayley-Hamilton Verification:")
print(p.subs(x, A))
