import sympy as sp

x, y, z = sp.symbols('x y z')

P = x**2
Q = y**2
R = z**2

divergence = (
    sp.diff(P, x) +
    sp.diff(Q, y) +
    sp.diff(R, z)
)

print("Divergence:")
print(divergence)

