import numpy as np

A = np.array([[2, 1],
              [1, -1]], dtype=float)

B = np.array([5, 1], dtype=float)

n = len(B)

# Gauss elimination
for i in range(n):
    for j in range(i+1, n):
        ratio = A[j][i] / A[i][i]
        A[j] = A[j] - ratio * A[i]
        B[j] = B[j] - ratio * B[i]

# Back substitution
x = np.zeros(n)

for i in range(n-1, -1, -1):
    x[i] = (B[i] - np.dot(A[i, i+1:], x[i+1:])) / A[i][i]

print("Solution:")
print(x)
